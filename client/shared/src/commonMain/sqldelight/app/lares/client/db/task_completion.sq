-- Completions and skips of a task (immutable). `completed_at` is epoch milliseconds; `occurrence` an ISO date or NULL.
CREATE TABLE task_completion (
    id TEXT NOT NULL PRIMARY KEY,
    task_id TEXT NOT NULL,
    completed_by TEXT NOT NULL,
    completed_at INTEGER NOT NULL,
    occurrence TEXT,
    skipped INTEGER NOT NULL
);

CREATE INDEX task_completion_task ON task_completion (task_id);

selectAll:
SELECT * FROM task_completion ORDER BY task_id, completed_at, id;

selectById:
SELECT * FROM task_completion WHERE id = ?;

selectByTask:
SELECT * FROM task_completion WHERE task_id = ? ORDER BY completed_at, id;

upsert:
INSERT OR REPLACE INTO task_completion (id, task_id, completed_by, completed_at, occurrence, skipped) VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM task_completion WHERE id = ?;

deleteAll:
DELETE FROM task_completion;
