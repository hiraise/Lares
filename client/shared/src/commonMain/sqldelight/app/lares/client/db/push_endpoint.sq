-- This device's UnifiedPush endpoint (FND-051). [registered_language] is the language the server last accepted it
-- with; NULL means it still has to be sent (offline at the time, or the UI language changed). At most one row.
CREATE TABLE push_endpoint (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    url TEXT NOT NULL,
    p256dh TEXT NOT NULL,
    auth TEXT NOT NULL,
    registered_language TEXT
);

get:
SELECT * FROM push_endpoint WHERE id = 1;

put:
INSERT OR REPLACE INTO push_endpoint (id, url, p256dh, auth, registered_language) VALUES (1, ?, ?, ?, NULL);

markRegistered:
UPDATE push_endpoint SET registered_language = ? WHERE id = 1 AND url = ?;

deleteAll:
DELETE FROM push_endpoint;
