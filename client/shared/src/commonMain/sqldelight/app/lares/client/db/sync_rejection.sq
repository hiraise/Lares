-- Mutations the server rejected; shown to the user until marked seen.
CREATE TABLE sync_rejection (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mutation_id TEXT NOT NULL,
    type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    code TEXT NOT NULL,
    message TEXT NOT NULL,
    at TEXT NOT NULL,
    seen INTEGER NOT NULL DEFAULT 0
);

insert:
INSERT INTO sync_rejection (mutation_id, type, entity_id, code, message, at) VALUES (?, ?, ?, ?, ?, ?);

selectUnseen:
SELECT * FROM sync_rejection WHERE seen = 0 ORDER BY id;

markSeen:
UPDATE sync_rejection SET seen = 1 WHERE id IN ?;

deleteAll:
DELETE FROM sync_rejection;
