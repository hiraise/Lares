-- Pending local mutations in creation order. `fields` is a JSON object (upsert) or NULL (delete).
CREATE TABLE sync_outbox (
    local_seq INTEGER PRIMARY KEY AUTOINCREMENT,
    mutation_id TEXT NOT NULL UNIQUE,
    type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    op TEXT NOT NULL,
    fields TEXT,
    created_at TEXT NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    last_error TEXT
);

CREATE INDEX sync_outbox_entity ON sync_outbox (type, entity_id);

enqueue:
INSERT INTO sync_outbox (mutation_id, type, entity_id, op, fields, created_at) VALUES (?, ?, ?, ?, ?, ?);

peek:
SELECT * FROM sync_outbox ORDER BY local_seq LIMIT ?;

byEntity:
SELECT * FROM sync_outbox WHERE type = ? AND entity_id = ? ORDER BY local_seq;

pendingEntities:
SELECT DISTINCT type, entity_id FROM sync_outbox;

count:
SELECT count(*) FROM sync_outbox;

markAttempt:
UPDATE sync_outbox SET attempts = attempts + 1, last_error = ? WHERE local_seq <= ?;

deleteByMutationId:
DELETE FROM sync_outbox WHERE mutation_id = ?;

deleteAll:
DELETE FROM sync_outbox;
