# Same as Caddyfile plus the ntfy push server (start with `--profile push`, LARES_CADDYFILE=Caddyfile.push).
{$LARES_DOMAIN} {
	encode zstd gzip
	# Map cache (ADR-0029).
	handle /map/* {
		reverse_proxy mapcache:8080
	}
	handle {
		reverse_proxy server:8080
	}
}

{$LARES_NTFY_DOMAIN} {
	reverse_proxy ntfy:80
}
