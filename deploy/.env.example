# Lares server configuration. Copy to `.env` in this directory and fill in the values:
#   cp .env.example .env && chmod 600 .env
# Never commit `.env`.

# --- Required ---------------------------------------------------------------------------------------------------

# Domain of your family server; its DNS A/AAAA record must point at this machine (ports 80 and 443 open).
LARES_DOMAIN=family.example.com

# Database password. Generate one, e.g.: openssl rand -hex 24
# POSTGRES_PASSWORD (database container) and LARES_DB_PASSWORD (server) must be the same value.
POSTGRES_PASSWORD=change-me
LARES_DB_PASSWORD=change-me

# --- Optional ---------------------------------------------------------------------------------------------------

# Address the app and QR codes use. Default: https://${LARES_DOMAIN}
#LARES_PUBLIC_URL=https://family.example.com

# Setup code for the first start (10 characters, letters and digits, no I, L, O, U).
# If empty, the server generates one and prints it to the log: docker compose logs server | grep "Setup code"
#LARES_SETUP_CODE=

# Server image and version. Default: ghcr.io/hiraise/lares-server:latest.
# Pin a version (e.g. 0.1.0) to update deliberately.
#LARES_IMAGE=ghcr.io/hiraise/lares-server
#LARES_VERSION=latest

# Log format: json (default in Docker) or plain.
#LARES_LOG_FORMAT=json

# --- Instant notifications (ntfy) ---------------------------------------------------------------------------------
# Start with: docker compose --profile push up -d   (needs a DNS record for the ntfy domain too)

# Caddy config: Caddyfile (default) or Caddyfile.push (also serves ntfy).
#LARES_CADDYFILE=Caddyfile.push

# Start ntfy with every `docker compose` command, without typing --profile push.
#COMPOSE_PROFILES=push

# Domain of the ntfy server. Default: ntfy.${LARES_DOMAIN}
#LARES_NTFY_DOMAIN=ntfy.family.example.com

# Only if this server resolves the ntfy domain to a private address (e.g. a hosts entry or split DNS):
# comma-separated host names the server may send pushes to despite the private address.
#LARES_PUSH_ALLOWED_HOSTS=ntfy.family.example.com

# --- Map ----------------------------------------------------------------------------------------------------------

# The phones load the map only from this server (https://<domain>/map/…). The map cache fetches style, tiles, fonts and
# icons from the upstream when someone first looks at an area, keeps them and deletes what nobody looked at for 7 days
# (ADR-0029). Default upstream: VersaTiles (free, no key, OpenStreetMap data). The upstream learns this server's
# address and which areas are viewed, never who views them or where anybody is.
#LARES_MAP_UPSTREAM=https://tiles.versatiles.org
#LARES_MAP_UPSTREAM_HOST=tiles.versatiles.org
# Disk the cache may use at most (nginx size, e.g. 500m, 2g). Default: 2g.
#LARES_MAP_CACHE_SIZE=2g
# Map styles (MapLibre style JSON). Styles on the upstream go through the cache; other addresses are loaded directly.
#LARES_MAP_STYLE_URL=https://tiles.versatiles.org/assets/styles/colorful/style.json
#LARES_MAP_STYLE_DARK_URL=https://tiles.versatiles.org/assets/styles/colorful-dark/style.json
# Font of the initials on the pins, as the upstream's glyph server names it (VersaTiles: noto_sans_bold).
#LARES_MAP_LABEL_FONT=noto_sans_bold
# Example: OpenFreeMap instead (blocked on some networks, e.g. in Russia in 2026):
#   LARES_MAP_UPSTREAM=https://tiles.openfreemap.org  LARES_MAP_UPSTREAM_HOST=tiles.openfreemap.org
#   LARES_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
#   LARES_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark  LARES_MAP_LABEL_FONT="Noto Sans Bold"

# Street addresses and address search (ADR-0026). The server sends the rounded coordinates of positions shown in the
# app (about 10 m) and typed address searches to this Nominatim-compatible service; phones never contact it.
# Default: OpenStreetMap's public Nominatim. Set it empty (LARES_GEOCODER_URL=) to turn addresses off, or point it at
# your own Nominatim / Photon with a Nominatim-compatible API.
#LARES_GEOCODER_URL=https://nominatim.openstreetmap.org
# Contact email sent with each request, as the Nominatim usage policy asks (optional).
#LARES_GEOCODER_EMAIL=you@example.com
