# FamilyHub server configuration. Copy to `.env` in this directory and fill in the values:
#   cp .env.example .env && chmod 600 .env
# Never commit `.env`.

# --- Required ---------------------------------------------------------------------------------------------------

# Domain of your family server; its DNS A/AAAA record must point at this machine (ports 80 and 443 open).
FAMILYHUB_DOMAIN=family.example.com

# Database password. Generate one, e.g.: openssl rand -hex 24
# POSTGRES_PASSWORD (database container) and FAMILYHUB_DB_PASSWORD (server) must be the same value.
POSTGRES_PASSWORD=change-me
FAMILYHUB_DB_PASSWORD=change-me

# --- Optional ---------------------------------------------------------------------------------------------------

# Address the app and QR codes use. Default: https://${FAMILYHUB_DOMAIN}
#FAMILYHUB_PUBLIC_URL=https://family.example.com

# Setup code for the first start (10 characters, letters and digits, no I, L, O, U).
# If empty, the server generates one and prints it to the log: docker compose logs server | grep "Setup code"
#FAMILYHUB_SETUP_CODE=

# Server image and version. Default: ghcr.io/OWNER/familyhub-server:latest (OWNER = the project's GitHub account).
# Pin a version (e.g. 0.1.0) to update deliberately.
#FAMILYHUB_IMAGE=ghcr.io/OWNER/familyhub-server
#FAMILYHUB_VERSION=latest

# Log format: json (default in Docker) or plain.
#FAMILYHUB_LOG_FORMAT=json

# --- Instant notifications (ntfy) ---------------------------------------------------------------------------------
# Start with: docker compose --profile push up -d   (needs a DNS record for the ntfy domain too)

# Caddy config: Caddyfile (default) or Caddyfile.push (also serves ntfy).
#FAMILYHUB_CADDYFILE=Caddyfile.push

# Domain of the ntfy server. Default: ntfy.${FAMILYHUB_DOMAIN}
#FAMILYHUB_NTFY_DOMAIN=ntfy.family.example.com

# Only if this server resolves the ntfy domain to a private address (e.g. a hosts entry or split DNS):
# comma-separated host names the server may send pushes to despite the private address.
#FAMILYHUB_PUSH_ALLOWED_HOSTS=ntfy.family.example.com
